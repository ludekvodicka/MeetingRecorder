{
  "manifest_version": 3,
  "name": "Meeting Recorder Companion",
  "version": "0.2.0",
  "minimum_chrome_version": "120",
  "description": "Offers Meeting Recorder when a supported browser meeting opens.",
  "permissions": ["alarms"],
  "host_permissions": ["http://127.0.0.1:8765/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://*.zoom.us/wc/*",
        "https://teams.microsoft.com/*",
        "https://teams.cloud.microsoft/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
